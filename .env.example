# ===== AI 大模型（OpenAI 兼容协议）=====
# 只需要改这三项即可切换 DeepSeek / 通义千问 / 混元 / Moonshot / 智谱 等
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-your-key-here
AI_MODEL=deepseek-chat

# ===== 会话签名密钥（生产必须改为随机长字符串）=====
SESSION_SECRET=please-change-this-to-a-random-32-chars-string

# ===== 预置管理员账号（可选，设置后该账号自动以 admin 角色存在）=====
# 不设置则跳过；设置了则首次访问自动创建，登录即以管理员身份进入
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ===== 存储驱动 =====
# file  = 本地开发，数据落在 .data/ 目录（默认）
# edgeone-kv = 生产环境，使用 EdgeOne Pages KV 存储
STORAGE_DRIVER=file
# ===== Cookie 安全标记（可选）=====
# 留空则自动判定：HTTPS 环境为 true，localhost 为 false。
# 若线上出现「登录后仍 401」，可显式设为 true；本地 HTTP 调试可设为 false。
# COOKIE_SECURE=true